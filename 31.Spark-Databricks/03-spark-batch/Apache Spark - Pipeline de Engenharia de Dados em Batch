{"cells":[{"cell_type":"code","metadata":{"id":"82c49338"},"source":["!pip install pyspark -q"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":239},"id":"88da6cb2","executionInfo":{"status":"ok","timestamp":1791689565419,"user_tz":180,"elapsed":15,"user":{"displayName":"","userId":""}},"outputId":"b06d492d-4bd4-4573-9c69-36780c3cf6eb"},"source":["from pyspark.sql import SparkSession\n","\n","# Initialize SparkSession with memory optimizations and AQE enabled\n","spark = SparkSession.builder \\\n","    .appName('BatchSalesPipeline') \\\n","    .config('spark.sql.adaptive.enabled', 'true') \\\n","    .config('spark.driver.memory', '4g') \\\n","    .config('spark.executor.memory', '4g') \\\n","    .getOrCreate()\n","\n","# Display the SparkSession object\n","print(\"SparkSession initialized successfully.\")\n","spark"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["SparkSession initialized successfully.\n"]},{"output_type":"execute_result","data":{"text/plain":["<pyspark.sql.session.SparkSession at 0x79e05a609d30>"],"text/html":["\n","            <div>\n","                <p><b>SparkSession - in-memory</b></p>\n","                \n","        <div>\n","            <p><b>SparkContext</b></p>\n","\n","            <p><a href=\"http://531ae75bdc39:4040\">Spark UI</a></p>\n","\n","            <dl>\n","              <dt>Version</dt>\n","                <dd><code>v4.0.4</code></dd>\n","              <dt>Master</dt>\n","                <dd><code>local[*]</code></dd>\n","              <dt>AppName</dt>\n","                <dd><code>BatchSalesPipeline</code></dd>\n","            </dl>\n","        </div>\n","        \n","            </div>\n","        "]},"metadata":{},"execution_count":9}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"93f712de","executionInfo":{"status":"ok","timestamp":1791689567841,"user_tz":180,"elapsed":289,"user":{"displayName":"","userId":""}},"outputId":"d6f7fa4b-5f5c-4f53-db6b-04d32088eb7b"},"source":["import os\n","import csv\n","import json\n","import random\n","from datetime import datetime, timedelta\n","from pyspark.sql.types import StructType, StructField, StringType, IntegerType, DoubleType, DateType\n","\n","# 1. Generate Synthetic Data\n","random.seed(42)\n","\n","# Customers data (some records might have missing/invalid entries for later cleaning)\n","customers_data = [\n","    {\"customer_id\": \"C101\", \"customer_name\": \"Alice Silva\", \"region\": \"Southeast\", \"join_date\": \"2021-05-20\"},\n","    {\"customer_id\": \"C102\", \"customer_name\": \"Bruno Souza\", \"region\": \"South\", \"join_date\": \"2020-11-12\"},\n","    {\"customer_id\": \"C103\", \"customer_name\": \"Carla Dias\", \"region\": \"Northeast\", \"join_date\": \"2022-01-15\"},\n","    {\"customer_id\": \"C104\", \"customer_name\": \"Daniel Oliveira\", \"region\": \"Midwest\", \"join_date\": \"2019-08-30\"},\n","    {\"customer_id\": \"C105\", \"customer_name\": \"Eduarda Santos\", \"region\": \"North\", \"join_date\": \"2023-04-05\"},\n","    {\"customer_id\": \"C106\", \"customer_name\": None, \"region\": \"Southeast\", \"join_date\": \"2022-10-10\"} # Missing name anomaly\n","]\n","\n","# Products data\n","products_data = [\n","    {\"product_id\": \"P001\", \"product_name\": \"Laptop\", \"category\": \"Electronics\", \"price\": 1200.00},\n","    {\"product_id\": \"P002\", \"product_name\": \"Smartphone\", \"category\": \"Electronics\", \"price\": 800.00},\n","    {\"product_id\": \"P003\", \"product_name\": \"Office Chair\", \"category\": \"Furniture\", \"price\": 250.00},\n","    {\"product_id\": \"P004\", \"product_name\": \"Desk Lamp\", \"category\": \"Furniture\", \"price\": 45.00},\n","    {\"product_id\": \"P005\", \"product_name\": \"Coffee Maker\", \"category\": \"Appliances\", \"price\": 90.00},\n","    {\"product_id\": \"P006\", \"product_name\": \"Blender\", \"category\": \"Appliances\", \"price\": 60.00}\n","]\n","\n","# Transactions data (including anomalies: negative prices, null values, etc.)\n","transactions_data = []\n","start_date = datetime(2023, 1, 1)\n","\n","for i in range(1, 101):\n","    tx_id = f\"T{1000 + i}\"\n","    cust = random.choice(customers_data)[\"customer_id\"]\n","    prod_obj = random.choice(products_data)\n","    prod = prod_obj[\"product_id\"]\n","\n","    # Introduce random anomalies\n","    if i == 50:\n","        qty = -2 # Invalid quantity anomaly\n","    elif i == 75:\n","        qty = None # Missing quantity anomaly\n","    else:\n","        qty = random.randint(1, 5)\n","\n","    tx_date = (start_date + timedelta(days=random.randint(0, 360))).strftime(\"%Y-%m-%d\")\n","\n","    # Sometime assign a product id that doesn't exist to test join robustness\n","    if i == 90:\n","        prod = \"P999\"\n","\n","    transactions_data.append({\n","        \"transaction_id\": tx_id,\n","        \"customer_id\": cust,\n","        \"product_id\": prod,\n","        \"quantity\": qty,\n","        \"transaction_date\": tx_date\n","    })\n","\n","# 2. Save Synthetic Datasets to files\n","os.makedirs('/tmp/raw_data', exist_ok=True)\n","\n","# Save customers as JSON\n","with open('/tmp/raw_data/customers.json', 'w') as f:\n","    for cust in customers_data:\n","        f.write(json.dumps(cust) + '\\n')\n","\n","# Save products as CSV\n","with open('/tmp/raw_data/products.csv', 'w', newline='') as f:\n","    writer = csv.DictWriter(f, fieldnames=[\"product_id\", \"product_name\", \"category\", \"price\"])\n","    writer.writeheader()\n","    writer.writerows(products_data)\n","\n","# Save transactions as CSV\n","with open('/tmp/raw_data/transactions.csv', 'w', newline='') as f:\n","    writer = csv.DictWriter(f, fieldnames=[\"transaction_id\", \"customer_id\", \"product_id\", \"quantity\", \"transaction_date\"])\n","    writer.writeheader()\n","    writer.writerows(transactions_data)\n","\n","# 3. Explicit Schemas definition\n","customers_schema = StructType([\n","    StructField(\"customer_id\", StringType(), True),\n","    StructField(\"customer_name\", StringType(), True),\n","    StructField(\"region\", StringType(), True),\n","    StructField(\"join_date\", StringType(), True) # loaded as string to convert to date during cleaning\n","])\n","\n","products_schema = StructType([\n","    StructField(\"product_id\", StringType(), True),\n","    StructField(\"product_name\", StringType(), True),\n","    StructField(\"category\", StringType(), True),\n","    StructField(\"price\", DoubleType(), True)\n","])\n","\n","transactions_schema = StructType([\n","    StructField(\"transaction_id\", StringType(), True),\n","    StructField(\"customer_id\", StringType(), True),\n","    StructField(\"product_id\", StringType(), True),\n","    StructField(\"quantity\", IntegerType(), True),\n","    StructField(\"transaction_date\", StringType(), True)\n","])\n","\n","# 4. Load files into Spark DataFrames enforcing schema\n","df_customers = spark.read.schema(customers_schema).json('/tmp/raw_data/customers.json')\n","df_products = spark.read.schema(products_schema).option(\"header\", \"true\").csv('/tmp/raw_data/products.csv')\n","df_transactions = spark.read.schema(transactions_schema).option(\"header\", \"true\").csv('/tmp/raw_data/transactions.csv')\n","\n","# 5. Display schemas and data\n","print(\"=== Customers Schema ===\")\n","df_customers.printSchema()\n","df_customers.show(5)\n","\n","print(\"=== Products Schema ===\")\n","df_products.printSchema()\n","df_products.show(5)\n","\n","print(\"=== Transactions Schema ===\")\n","df_transactions.printSchema()\n","df_transactions.show(5)\n"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Customers Schema ===\n","root\n"," |-- customer_id: string (nullable = true)\n"," |-- customer_name: string (nullable = true)\n"," |-- region: string (nullable = true)\n"," |-- join_date: string (nullable = true)\n","\n","+-----------+---------------+---------+----------+\n","|customer_id|  customer_name|   region| join_date|\n","+-----------+---------------+---------+----------+\n","|       C101|    Alice Silva|Southeast|2021-05-20|\n","|       C102|    Bruno Souza|    South|2020-11-12|\n","|       C103|     Carla Dias|Northeast|2022-01-15|\n","|       C104|Daniel Oliveira|  Midwest|2019-08-30|\n","|       C105| Eduarda Santos|    North|2023-04-05|\n","+-----------+---------------+---------+----------+\n","only showing top 5 rows\n","=== Products Schema ===\n","root\n"," |-- product_id: string (nullable = true)\n"," |-- product_name: string (nullable = true)\n"," |-- category: string (nullable = true)\n"," |-- price: double (nullable = true)\n","\n","+----------+------------+-----------+------+\n","|product_id|product_name|   category| price|\n","+----------+------------+-----------+------+\n","|      P001|      Laptop|Electronics|1200.0|\n","|      P002|  Smartphone|Electronics| 800.0|\n","|      P003|Office Chair|  Furniture| 250.0|\n","|      P004|   Desk Lamp|  Furniture|  45.0|\n","|      P005|Coffee Maker| Appliances|  90.0|\n","+----------+------------+-----------+------+\n","only showing top 5 rows\n","=== Transactions Schema ===\n","root\n"," |-- transaction_id: string (nullable = true)\n"," |-- customer_id: string (nullable = true)\n"," |-- product_id: string (nullable = true)\n"," |-- quantity: integer (nullable = true)\n"," |-- transaction_date: string (nullable = true)\n","\n","+--------------+-----------+----------+--------+----------------+\n","|transaction_id|customer_id|product_id|quantity|transaction_date|\n","+--------------+-----------+----------+--------+----------------+\n","|         T1001|       C106|      P001|       1|      2023-05-21|\n","|         T1002|       C102|      P002|       2|      2023-02-22|\n","|         T1003|       C106|      P006|       5|      2023-02-14|\n","|         T1004|       C105|      P004|       1|      2023-01-16|\n","|         T1005|       C101|      P002|       2|      2023-09-16|\n","+--------------+-----------+----------+--------+----------------+\n","only showing top 5 rows\n"]}]},{"cell_type":"markdown","metadata":{"id":"964b025a"},"source":["# Task\n","Create an end-to-end batch data engineering pipeline using PySpark. The pipeline must include: environment setup and SparkSession configuration; generation of a synthetic sales dataset containing transactions, customers, and products saved in a raw format (CSV/JSON); data loading with an explicit schema; data cleaning (handling nulls, type conversions, and filtering anomalies); enriching the dataset via JOINs and calculated columns using Spark SQL functions; performing complex aggregations and Window Functions (e.g., partitioning by region/category to find top products); and finally, optimizing storage by persisting the final clean dataset in partitioned Parquet format."]},{"cell_type":"markdown","metadata":{"id":"4c064485"},"source":["## Geração e Carga do Dataset de Vendas\n","\n","### Subtask:\n","Generate a synthetic sales dataset (transactions, customers, products), save it to raw formats (CSV/JSON), and load it into Spark DataFrames using explicit schemas.\n"]},{"cell_type":"markdown","metadata":{"id":"a3fcd843"},"source":["## Limpeza de Dados e Tratamento de Anomalias\n","\n","### Subtask:\n","Perform typical data cleaning operations on transactions, customers, and products Spark DataFrames.\n"]},{"cell_type":"markdown","metadata":{"id":"a5f5d33f"},"source":["**Reasoning**:\n","We will execute a Python code block to clean the transactions, customers, and products DataFrames as instructed, handling type conversions, filtering out anomalies, and filling in missing names.\n","\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"f9dc6fc0","executionInfo":{"status":"ok","timestamp":1791689335348,"user_tz":180,"elapsed":1649,"user":{"displayName":"","userId":""}},"outputId":"8b2c7c40-109a-40e8-cff7-548aec4c4262"},"source":["from pyspark.sql.functions import col, to_date, coalesce, lit\n","\n","# 1. Clean transactions DataFrame\n","# Convert transaction_date to DateType and filter out non-positive or null quantities\n","df_transactions_clean = df_transactions \\\n","    .withColumn(\"transaction_date\", to_date(col(\"transaction_date\"), \"yyyy-MM-dd\")) \\\n","    .filter((col(\"quantity\").isNotNull()) & (col(\"quantity\") > 0))\n","\n","# 2. Clean customers DataFrame\n","# Convert join_date to DateType and fill null/missing customer_name with 'Unknown Customer'\n","df_customers_clean = df_customers \\\n","    .withColumn(\"join_date\", to_date(col(\"join_date\"), \"yyyy-MM-dd\")) \\\n","    .withColumn(\"customer_name\", coalesce(col(\"customer_name\"), lit(\"Unknown Customer\")))\n","\n","# 3. Clean products DataFrame\n","# Filter out any non-positive or null prices to ensure robustness\n","df_products_clean = df_products \\\n","    .filter((col(\"price\").isNotNull()) & (col(\"price\") > 0))\n","\n","# 4. Print schemas and show a sample of rows to verify\n","print(\"=== Cleaned Transactions ===\")\n","df_transactions_clean.printSchema()\n","df_transactions_clean.show(5)\n","\n","print(\"=== Cleaned Customers ===\")\n","df_customers_clean.printSchema()\n","df_customers_clean.show(5)\n","\n","print(\"=== Cleaned Products ===\")\n","df_products_clean.printSchema()\n","df_products_clean.show(5)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Cleaned Transactions ===\n","root\n"," |-- transaction_id: string (nullable = true)\n"," |-- customer_id: string (nullable = true)\n"," |-- product_id: string (nullable = true)\n"," |-- quantity: integer (nullable = true)\n"," |-- transaction_date: date (nullable = true)\n","\n","+--------------+-----------+----------+--------+----------------+\n","|transaction_id|customer_id|product_id|quantity|transaction_date|\n","+--------------+-----------+----------+--------+----------------+\n","|         T1001|       C106|      P001|       1|      2023-05-21|\n","|         T1002|       C102|      P002|       2|      2023-02-22|\n","|         T1003|       C106|      P006|       5|      2023-02-14|\n","|         T1004|       C105|      P004|       1|      2023-01-16|\n","|         T1005|       C101|      P002|       2|      2023-09-16|\n","+--------------+-----------+----------+--------+----------------+\n","only showing top 5 rows\n","=== Cleaned Customers ===\n","root\n"," |-- customer_id: string (nullable = true)\n"," |-- customer_name: string (nullable = false)\n"," |-- region: string (nullable = true)\n"," |-- join_date: date (nullable = true)\n","\n","+-----------+---------------+---------+----------+\n","|customer_id|  customer_name|   region| join_date|\n","+-----------+---------------+---------+----------+\n","|       C101|    Alice Silva|Southeast|2021-05-20|\n","|       C102|    Bruno Souza|    South|2020-11-12|\n","|       C103|     Carla Dias|Northeast|2022-01-15|\n","|       C104|Daniel Oliveira|  Midwest|2019-08-30|\n","|       C105| Eduarda Santos|    North|2023-04-05|\n","+-----------+---------------+---------+----------+\n","only showing top 5 rows\n","=== Cleaned Products ===\n","root\n"," |-- product_id: string (nullable = true)\n"," |-- product_name: string (nullable = true)\n"," |-- category: string (nullable = true)\n"," |-- price: double (nullable = true)\n","\n","+----------+------------+-----------+------+\n","|product_id|product_name|   category| price|\n","+----------+------------+-----------+------+\n","|      P001|      Laptop|Electronics|1200.0|\n","|      P002|  Smartphone|Electronics| 800.0|\n","|      P003|Office Chair|  Furniture| 250.0|\n","|      P004|   Desk Lamp|  Furniture|  45.0|\n","|      P005|Coffee Maker| Appliances|  90.0|\n","+----------+------------+-----------+------+\n","only showing top 5 rows\n"]}]},{"cell_type":"markdown","metadata":{"id":"84e6921e"},"source":["## Transformações e Enriquecimento de Dados\n","\n","### Subtask:\n","Perform JOIN operations between transactions, customers, and products DataFrames, and create calculated columns.\n"]},{"cell_type":"markdown","metadata":{"id":"47494c4b"},"source":["**Reasoning**:\n","Perform inner joins to combine cleaned transactions, customers, and products, then create the 'total_revenue' calculated column as instructed.\n","\n"]},{"cell_type":"markdown","metadata":{"id":"13312f29"},"source":["**Reasoning**:\n","Compute complex aggregations (group by region and category) and apply analytical window functions to rank and find top-performing products by region as requested.\n","\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5e1e50ba","executionInfo":{"status":"ok","timestamp":1791689370540,"user_tz":180,"elapsed":3911,"user":{"displayName":"","userId":""}},"outputId":"588a2a58-6de7-4e45-bd60-3f20c50928bb"},"source":["from pyspark.sql import Window\n","from pyspark.sql.functions import sum, avg, row_number, desc, col\n","\n","# 1. Aggregations: Total revenue and average price by region and category\n","df_agg = df_sales_enriched.groupBy(\"region\", \"category\") \\\n","    .agg(\n","        sum(\"total_revenue\").alias(\"total_sales_revenue\"),\n","        avg(\"price\").alias(\"average_price\")\n","    ) \\\n","    .orderBy(\"region\", desc(\"total_sales_revenue\"))\n","\n","print(\"=== Aggregation: Revenue and Avg Price by Region/Category ===\")\n","df_agg.printSchema()\n","df_agg.show(10)\n","\n","# 2. Window Functions: Top-performing products within each region\n","# We first sum the revenue per product within each region to identify product-level performance\n","df_product_region_revenue = df_sales_enriched.groupBy(\"region\", \"product_id\", \"product_name\", \"category\") \\\n","    .agg(sum(\"total_revenue\").alias(\"product_region_revenue\"))\n","\n","# Define Window specification partitioned by region and ordered by total product revenue descending\n","window_spec = Window.partitionBy(\"region\").orderBy(desc(\"product_region_revenue\"))\n","\n","# Apply window function to rank the products\n","df_ranked = df_product_region_revenue.withColumn(\"rank\", row_number().over(window_spec))\n","\n","# Filter to select top 2 performing products for each region\n","df_top_products = df_ranked.filter(col(\"rank\") <= 2)\n","\n","print(\"=== Window Function: Top 2 Products per Region ===\")\n","df_top_products.printSchema()\n","df_top_products.show(10)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Aggregation: Revenue and Avg Price by Region/Category ===\n","root\n"," |-- region: string (nullable = true)\n"," |-- category: string (nullable = true)\n"," |-- total_sales_revenue: double (nullable = true)\n"," |-- average_price: double (nullable = true)\n","\n","+---------+-----------+-------------------+------------------+\n","|   region|   category|total_sales_revenue|     average_price|\n","+---------+-----------+-------------------+------------------+\n","|  Midwest|Electronics|             6400.0|             800.0|\n","|  Midwest|  Furniture|             2000.0|             250.0|\n","|  Midwest| Appliances|             1740.0|              70.0|\n","|    North|Electronics|            28800.0|            1100.0|\n","|    North|  Furniture|             1725.0|             127.0|\n","|    North| Appliances|              930.0|              84.0|\n","|Northeast|Electronics|            14000.0|             960.0|\n","|Northeast|  Furniture|             2565.0|132.85714285714286|\n","|Northeast| Appliances|             1200.0|              60.0|\n","|    South|Electronics|            23600.0| 977.7777777777778|\n","+---------+-----------+-------------------+------------------+\n","only showing top 10 rows\n","=== Window Function: Top 2 Products per Region ===\n","root\n"," |-- region: string (nullable = true)\n"," |-- product_id: string (nullable = true)\n"," |-- product_name: string (nullable = true)\n"," |-- category: string (nullable = true)\n"," |-- product_region_revenue: double (nullable = true)\n"," |-- rank: integer (nullable = false)\n","\n","+---------+----------+------------+-----------+----------------------+----+\n","|   region|product_id|product_name|   category|product_region_revenue|rank|\n","+---------+----------+------------+-----------+----------------------+----+\n","|  Midwest|      P002|  Smartphone|Electronics|                6400.0|   1|\n","|  Midwest|      P003|Office Chair|  Furniture|                2000.0|   2|\n","|    North|      P001|      Laptop|Electronics|               24000.0|   1|\n","|    North|      P002|  Smartphone|Electronics|                4800.0|   2|\n","|Northeast|      P001|      Laptop|Electronics|                8400.0|   1|\n","|Northeast|      P002|  Smartphone|Electronics|                5600.0|   2|\n","|    South|      P002|  Smartphone|Electronics|               12800.0|   1|\n","|    South|      P001|      Laptop|Electronics|               10800.0|   2|\n","|Southeast|      P001|      Laptop|Electronics|               21600.0|   1|\n","|Southeast|      P002|  Smartphone|Electronics|               19200.0|   2|\n","+---------+----------+------------+-----------+----------------------+----+\n","\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"21f863d2","executionInfo":{"status":"ok","timestamp":1791689350091,"user_tz":180,"elapsed":1541,"user":{"displayName":"","userId":""}},"outputId":"664e8377-1616-4e58-b7a4-f285e66f91b0"},"source":["from pyspark.sql.functions import col\n","\n","# 1. Join transactions with customers\n","df_joined_cust = df_transactions_clean.join(df_customers_clean, on=\"customer_id\", how=\"inner\")\n","\n","# 2. Join the resulting DataFrame with products\n","df_enriched = df_joined_cust.join(df_products_clean, on=\"product_id\", how=\"inner\")\n","\n","# 3. Create 'total_revenue' column by multiplying 'quantity' and 'price'\n","d